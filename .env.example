# Mattermost webhook: the ID or the whole https://team.stack360.co/hooks/<id> link
MATTERMOST_WEBHOOK_ID=***********
NEXT_PUBLIC_NODE_ENV=production
# Optional: also email each website lead to sales@stack360.co through Resend. Set both, or neither.
# The key needs only "Sending access" for the verified domain; the sender must use that domain.
RESEND_API_KEY=
LEAD_EMAIL_FROM="Stack360 website <leads@mail.stack360.co>"
# Optional: Calendly link for the "Book a 20-minute call" button, e.g. https://calendly.com/stack360/20min
NEXT_PUBLIC_CALENDLY_URL=
